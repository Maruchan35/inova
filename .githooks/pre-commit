#!/bin/sh
# Bloquea commits directos en main (regla del equipo, ver AGENTS.md).
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
  echo "BLOQUEADO: no se hace commit directo en main."
  echo "Crea una rama para tu tarea:  git checkout -b <bloque>/<tarea>"
  exit 1
fi
exit 0
