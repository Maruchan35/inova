# Copia este archivo como .env y pon tu clave. .env nunca se sube a Git.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# "enabled" activa el modo pensar: ~8x más lento y ~4x más caro, sin mejora visible al resumir.
DEEPSEEK_THINKING=disabled
# Tope de gasto diario del chatbot en dólares: al llegar, responde sin IA (con los fragmentos) hasta el día siguiente.
DEEPSEEK_TOPE_DIARIO_USD=3

# Avisos por WhatsApp (bot de backend/whatsapp). Sin WHATSAPP_BOT_URL, los mensajes solo quedan en /api/prueba/avisos.
WHATSAPP_BOT_URL=
# Una frase secreta cualquiera: la usan el backend y el bot para hablar entre ellos.
WHATSAPP_BOT_TOKEN=
# Enlace que llega en el WhatsApp; {id} es el documento. Debe ser una dirección pública para que abra en el celular.
ENLACE_DOCUMENTO=http://localhost:5173/documento/{id}
